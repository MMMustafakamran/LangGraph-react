# Names only. Copy the values into the files named below; never commit them.

# agent/.env (read by `langgraphjs dev`; @langchain/openai reads it, the doc's agents use gpt-5-mini)
OPENAI_API_KEY=

# frontend/.env.local (the doc's own override for the agent URL; harness port, never 8123/8000)
LANGGRAPH_DEPLOYMENT_URL=http://localhost:8050

# Optional, frontend/.env.local: the doc's runtime routes pass process.env.LANGSMITH_API_KEY (works without it)
# LANGSMITH_API_KEY=

# Pipeline only (GitHub secrets in CI, local env otherwise; not needed to run the app)
# FISH_API_KEY=            narration TTS (qa-kit narrate)
# ANTHROPIC_API_KEY=       clip review + narration rewrite (`claude` CLI)
# VOICE_REF_WAV_B64=       private voice reference, base64 (never as a file in this repo)
# VOICE_REF_TXT=           its transcript
